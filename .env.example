# Copy to .env and fill in. The only secret of the project; everything below it is optional.
ANTHROPIC_API_KEY=

# --- Optional: host ports published by docker compose (the project's own Postgres and Redis) ---
# The defaults stay clear of anything installed on the machine. Change one only if it is taken.
# POSTGRES_PORT=55432
# REDIS_PORT=56379
# API_PORT=3000
# WEB_PORT=8080

# --- Optional: `pnpm dev` in backend/ on the host (the defaults match the ports above) ---
# DATABASE_URL=postgres://cv:cv@127.0.0.1:55432/cv
# REDIS_URL=redis://127.0.0.1:56379
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LOG_LEVEL=info
# Swagger UI at /api/docs. `pnpm dev` turns it on; set true here to have it in docker compose too.
# API_DOCS=false
